+
+fn is_xet_signed_range_forbidden(err: &anyhow::Error) -> bool {
+    let err_msg = format!("{err:?}").to_lowercase();
+
+    err_msg.contains("403")
+        && (err_msg.contains("s3::get_range")
+            || err_msg.contains("cdn.hf.co/xorbs")
+            || err_msg.contains("x-xet-session-id")
+            || (err_msg.contains("signed") && err_msg.contains("range"))
+            || err_msg.contains("signature"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn detects_xet_signed_range_forbidden_errors() {
+        let err = anyhow!(
+            "ReqwestMiddlewareError: Request failed after all retries. HTTP status client error (403 Forbidden) for url (https://cdn.hf.co/xorbs/default/...): s3::get_range"
+        );
+
+        assert!(is_xet_signed_range_forbidden(&err));
+    }
+
+    #[test]
+    fn ignores_non_signed_range_forbidden_errors() {
+        let err = anyhow!("head request failed after 4 attempts: HTTP 403");
+
+        assert!(!is_xet_signed_range_forbidden(&err));
+    }
+
+    #[test]
+    fn ignores_generic_xet_forbidden_errors() {
+        let err = anyhow!("xet download failed: HTTP status client error (403 Forbidden)");
+
+        assert!(!is_xet_signed_range_forbidden(&err));
+    }
+}
